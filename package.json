{
  "name": "agent-ad-footprint",
  "version": "0.1.0",
  "private": true,
  "description": "Measures whether AI browsing agents leave a tracking footprint that the online ad market reacts to (header-bidding bids on a publisher page).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "measure": "node scripts/measure.js",
    "agent:setup": "node scripts/agent-setup.js",
    "profile:copy": "node scripts/copy-profile.js",
    "summarize": "node scripts/summarize.js",
    "summarize:pilot": "node scripts/summarize.js --file data/pilot-2026-10-19/measurements.jsonl --shops sportscheck.com,intersport.de,idealo.de,amazon.de,zalando.de",
    "test": "node --test"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.83"
  }
}
